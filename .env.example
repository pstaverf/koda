NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false

DATABASE_URL=postgres://koda:koda@localhost:5432/koda
REDIS_URL=redis://localhost:6379

ACCESS_TOKEN_SECRET=dev-access-token-secret-replace-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

CODE_HASH_SECRET=dev-code-hash-secret-replace-in-production
EMAIL_HASH_SECRET=dev-email-hash-secret-replace-in-production

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_CLIENTS=web
COOKIE_SECURE=false

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=mailpit
SMTP_PASSWORD=mailpit
SMTP_FROM=Koda <no-reply@koda.local>

S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=koda
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_URL_TTL_SECONDS=3600

TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000000AA
